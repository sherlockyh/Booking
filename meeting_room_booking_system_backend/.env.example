# ==================== MySQL 数据库 ====================
# 容器内直接连 mysql 服务名；若本机不用 docker 跑 node，才改成 127.0.0.1
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=booking_app
# 数据库密码（本地可弱密码；线上务必强密码）
DB_PASSWORD=请改成你的密码
DB_DATABASE=meeting_room_booking_system

# ==================== Redis ====================
# 容器内直接连 redis 服务名；若本机不用 docker 跑 node，才改成 127.0.0.1
REDIS_HOST=redis
# 容器内端口 6379；宿主机映射端口 6380 见 docker-compose.override.yml
REDIS_PORT=6379

# ==================== Nest 应用 ====================
PORT=3000

# ==================== 日志 ====================
# 日志级别：error/warn/info/http/verbose/debug；缺省为生产 http、开发 debug
LOG_LEVEL=http
# 按天轮转日志目录（本地相对 backend 目录；容器内为 /app/logs 挂载卷）
LOG_DIR=logs
# 日志文件保留时长，超期自动清理并压缩归档
LOG_MAX_FILES=14d

# ==================== 统一网关 / 前端 ====================
# 腾讯云镜像仓库中的前端镜像地址
# 个人版常见格式：ccr.ccs.tencentyun.com/<namespace>/<repo>:<tag>
# 企业版以控制台显示的镜像地址为准
FRONTEND_IMAGE=请改成腾讯云前端镜像地址
# 统一入口端口，例如 http://服务器IP:8080
FRONTEND_PORT=8080

# ==================== JWT ====================
# 32 位以上随机串，生成命令：openssl rand -base64 32
JWT_SECRET=请改成随机串
JWT_EXPIRES_IN=30m
