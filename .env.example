# ===== 数据库 =====
# 容器内直接连 mysql 服务名；若本机不用 docker 跑 node，才改成 127.0.0.1
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=booking_app
# 数据库密码（本地弱密码；线上务必换成强密码）
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_DATABASE=meeting_room_booking_system

# 前端 Nginx 对宿主机暴露的端口（docker-compose.yml 的 FRONTEND_PORT）
FRONTEND_PORT=8080

# ===== Redis =====
# 容器内直接连 redis 服务名；若本机不用 docker 跑 node，才改成 127.0.0.1
REDIS_HOST=redis
# 容器内端口 6379；宿主机映射端口 6380 见 docker-compose.override.yml
REDIS_PORT=6379

# ===== 应用 =====
PORT=3000

# ===== 日志 =====
# 日志级别：error/warn/info/http/verbose/debug；缺省为生产 http、开发 debug
# 需要看 debug 明细（响应体/用户信息）排查问题时改成 debug 再重启
LOG_LEVEL=http

# ===== JWT =====
# 本地用占位值即可；上线必须替换为随机串
JWT_SECRET=
# access token 有效期
JWT_EXPIRES_IN=30m
# refresh token 有效期（一次性使用，刷新时会轮转签发新 token）
JWT_REFRESH_EXPIRES_IN=7d

# ===== MinIO 对象存储 =====
# S3 API 宿主机端口 9000（浏览器访问头像）、Web 控制台端口 9001
# 密码至少 8 位；部署到公网务必换强密码（9001 控制台也会暴露在公网）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_BUCKET=meeting-room
S3_REGION=us-east-1
# S3_ENDPOINT 部署时不用配置：后端在 compose 网络内通过服务名 http://minio:9000
# 访问 MinIO，不经过外网；仅在本机不用 docker 裸跑后端时才改成 http://127.0.0.1:9000
#
# 浏览器访问对象的公开地址（走 S3 API 宿主机端口）。
# 本地保持默认；部署时必须改成 http://服务器IP:9000 或域名，
# 否则访客浏览器会把 localhost 解析到访客自己的电脑，头像全部裂图
S3_PUBLIC_BASE_URL=http://localhost:9000
